// Generated by `pnpm deploy:sync`. Edit `deploy/config.ts`, then re-run sync.
// Cloudflare runtime: containers (default)
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "better-auth-starterkit",
	"main": "deploy/cloudflare/container-worker.ts",
	"compatibility_date": "2026-07-01",
	"compatibility_flags": ["nodejs_compat"],
	"containers": [
		{
			"class_name": "AuthServerContainer",
			"image": "./Dockerfile",
			"max_instances": 3
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "AuthServerContainer",
				"name": "AUTH_SERVER"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["AuthServerContainer"]
		}
	],
	"observability": {
		"enabled": true
	}
}
