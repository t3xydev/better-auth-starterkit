# Branding

# App display name (header, metadata, PWA, OG)
APPLICATION_NAME=Better Auth StarterKit

# Optional theme (OKLCH). Leave blank for defaults.
NEXT_PUBLIC_PRIMARY_HUE=
NEXT_PUBLIC_PRIMARY_CHROMA=

# Optional CDN asset URLs
FAVICON_URL=
ICON_URL=
OPENGRAPH_IMAGE_URL=
# Header logo; when set, replaces APPLICATION_NAME text
LOGO_URL=

# Set to "true" to hide the GitHub icon in the header
NEXT_PUBLIC_HIDE_GITHUB=

# Set to "true" to enable Better Auth organizations (members, invites, /organization/*)
NEXT_PUBLIC_ORGANIZATIONS_ENABLED=

# Set to "true" to require a better-invite link for new sign-ups (first user can still bootstrap)
NEXT_PUBLIC_INVITE_ONLY=

# --- Better Auth (required) ---
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated extra trusted origins (BETTER_AUTH_URL is always included)
BETTER_AUTH_TRUSTED_ORIGINS=
BETTER_AUTH_SECRET=
BETTER_AUTH_API_KEY=
BETTER_AUTH_IDENTIFY_URL=

# --- Database (required) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/better_auth

# --- OAuth / OIDC (optional overrides; default to BETTER_AUTH_URL) ---
OAUTH_ISSUER=
OAUTH_AUDIENCE=

# --- Email (optional) ---
# Prefer SMTP when set; otherwise Better Auth Infra (BETTER_AUTH_API_KEY); else console.
# Resend: use port 465 (implicit TLS). 587 (STARTTLS) often times out.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Analytics (optional — omit key to disable PostHog) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
